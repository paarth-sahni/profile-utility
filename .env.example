GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL_ANALYZE=openai/gpt-oss-20b
LLM_MODEL_EXTRACT=openai/gpt-oss-120b
LLM_MODEL_FALLBACK=openai/gpt-oss-20b
LLM_REASONING_EFFORT=medium
MAX_UPLOAD_MB=10

# --- Supabase (LOCAL stack only; run `npm run db:start`, then `npx supabase status -o env`) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable key: used by the browser for authentication only.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only, never NEXT_PUBLIC_. Read ONLY by lib/sync/adminClient.ts (the compliance registry sync calls its three
# service_role-only database functions); also used by seed/admin scripts and tests. Leave empty in production until the
# compliance migrations are applied and verified (see docs/compliance-verify.sql).
SUPABASE_SERVICE_ROLE_KEY=
AUTH_ALLOWED_DOMAIN=infobeans.com

# --- Google sign-in (local) ---
# The Google OAuth client is read by the Supabase CLI from supabase/.env (git-ignored), NOT by Next.js:
#   GOOGLE_CLIENT_ID=...
#   GOOGLE_CLIENT_SECRET=...
# See README "Local auth setup". Authorized redirect URI: http://127.0.0.1:54321/auth/v1/callback

# --- Open in Google Docs (optional) ---
# OAuth client ID of a "Web application" client in Google Cloud (see README "Open in Google Docs"). It is public
# by design (it ends up in the browser); there is NO client secret for this feature. Leave empty to hide the buttons.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- PDF (optional; see README "PDF") ---
# LibreOffice binary used by POST /api/pdf (default: soffice on the PATH).
#SOFFICE_PATH=/usr/bin/soffice
# Folder with the Lexend .ttf files given to LibreOffice (default: public/fonts).
#PDF_FONTS_DIR=

# --- Compliance registry sync from Google Sheets (server-only; read-only service account) ---
# The id (or the whole sheet link), the service-account address and its private key on ONE line, using the two
# characters backslash and n for the line breaks, inside double quotes. Never commit real values. The sheet must be shared with that address as Viewer.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SA_CLIENT_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
# Optional: read only these tabs (comma separated). Default: every tab. The list is one tab ("Sheet1") with the header
# S.No | Client Name | Legal Name | Friendly Name | Client Group; only columns A:E are ever read.
#SYNC_TAB_NAMES=Sheet1

# --- Client-name compliance rule (server-only) ---
# OFF by default: with this unset nothing is checked and no service key is needed, so the code can be deployed before the
# registry exists. Set to "on" ONLY after the compliance migrations are applied and verified and a first sync has run:
# then a profile that names a registered client is refused at Preview, PDF and Submit (422), and if the registry cannot
# be loaded those steps are refused too (503, fail closed). Setting it back to off (and restarting) is the instant kill switch.
#COMPLIANCE_ENFORCE=on
# Shared secret for the scheduler (ops/profile-sync.timer). Generate with: openssl rand -hex 32. Without it the scheduled
# endpoint answers 503 and only the administrator's button can start a sync.
SYNC_CRON_SECRET=
# Time zone in which "the 5th and 20th" are counted (default Asia/Kolkata).
#SYNC_TIMEZONE=Asia/Kolkata
# Optional reminder on the admin page: the day the service-account key was created (YYYY-MM-DD). Rotate at about 12 months.
#GOOGLE_SA_KEY_CREATED=2026-10-24
